# ─────────────────────────────────────────────────────────────
# SSO — Session NextAuth PARTAGÉE avec l'Espace Adhérent
# ─────────────────────────────────────────────────────────────
# NEXTAUTH_SECRET doit être RIGOUREUSEMENT IDENTIQUE à celui de
# l'Espace Adhérent : c'est la clé qui permet à getToken() de vérifier
# et décoder le JWT FEG émis par adherent.lafeg.ga. = SSO.
NEXTAUTH_SECRET=COLLER_ICI_LE_MEME_SECRET_QUE_ESPACE_ADHERENT

# URL publique de CETTE application.
NEXTAUTH_URL=https://soustraitance.lafeg.ga

# Domaine parent partagé : le cookie de session posé par l'Espace Adhérent
# sur .lafeg.ga est ainsi envoyé automatiquement à cette app.
# En local (http) : laisser vide → cookie "next-auth.session-token" sur localhost.
COOKIE_DOMAIN=.lafeg.ga

# URL de l'Espace Adhérent (redirection login + bouton "← Espace Adhérent").
NEXT_PUBLIC_ESPACE_ADHERENT_URL=https://adherent.lafeg.ga

# ─────────────────────────────────────────────────────────────
# Base de données MÉTIER (séparée de l'Espace Adhérent) — Postgres/Prisma
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/soustraitance
